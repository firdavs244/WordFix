# =============================================================================
# WordFix Frontend — Production Multi-Stage Dockerfile
# Stage 1: Build React app with Vite
# Stage 2: Serve via nginx (also acts as reverse proxy)
# =============================================================================

# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies first (layer caching)
COPY package.json package-lock.json* ./
RUN npm ci

# Copy source code
COPY . .

# Build args for Vite env variables (injected at build time)
ARG VITE_API_URL=/api/v1
ARG VITE_APP_NAME=WordFix
ARG VITE_APP_VERSION=1.0.0

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_APP_NAME=$VITE_APP_NAME
ENV VITE_APP_VERSION=$VITE_APP_VERSION

# Build the production bundle
RUN npm run build

# ── Stage 2: Serve with nginx ─────────────────────────────────────────────────
FROM nginx:alpine

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy our custom nginx config
COPY --from=builder /app/dist /usr/share/nginx/html

# nginx config will be mounted via docker-compose volume

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
